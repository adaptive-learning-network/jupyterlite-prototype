@prefix al:      <https://adaptive-learning-network.github.io/adaptive-learning-ontology/al#> .
@prefix dreyfus: <https://adaptive-learning-network.github.io/adaptive-learning-ontology/scales/dreyfus#> .
@prefix ex:      <https://adaptive-learning-network.github.io/jupyterlite-prototype/catalog#> .
@prefix g:       <https://adaptive-learning-network.github.io/jupyterlite-prototype/graph/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# Prototype curriculum: Public Health Informatics for FETP, Units 1–3
# "Using Informatics to Get Information Faster" (Version 3 course materials,
# used with permission). Exercises follow the unit's slides: data versus
# information, exploring a dataset with software, combining variables into
# information, machine-readable datasets, and case-based versus aggregate data.
# Units 1 and 2 add Python-only data-to-decision and system-map pilots. Other scored Unit 3
# activities have Python and R notebooks bound to the same al: capability.
#
# This file is the source of truth. scripts/build_catalog.py validates it with
# the al: shapes and projects it to app-assets/adaptive-learning/catalog.json for the browser.
# It will become the unit module of the informatics capability pack.

g:catalog {
  ex:framework a al:CapabilityFramework ;
      dcterms:title "Public health informatics: Units 1–14 prototype"@en ;
      al:usesScale dreyfus:scale ;
      al:hasCapability ex:cap-data-to-decision, ex:cap-system-map, ex:cap-data-vs-information, ex:cap-explore-dataset, ex:cap-filter-records,
                       ex:cap-combine-variables, ex:cap-machine-readable, ex:cap-case-vs-aggregate .

  ex:cap-data-to-decision a al:Capability ; skos:inScheme ex:framework ; skos:notation "data-to-decision" ; al:ordinal 0 ;
      skos:prefLabel "Select a public health action from reported counts"@en .
  ex:cap-system-map a al:Capability ; skos:inScheme ex:framework ; skos:notation "system-map" ; al:ordinal 1 ;
      skos:prefLabel "Trace a report through health information systems"@en .
  ex:cap-data-vs-information a al:Capability ; skos:inScheme ex:framework ; skos:notation "data-vs-information" ; al:ordinal 2 ;
      skos:prefLabel "Distinguish data from information"@en .
  ex:cap-explore-dataset a al:Capability ; skos:inScheme ex:framework ; skos:notation "explore-dataset" ; al:ordinal 3 ;
      skos:prefLabel "Explore a dataset with software"@en .
  ex:cap-filter-records a al:Capability ; skos:inScheme ex:framework ; skos:notation "filter-records" ; al:ordinal 4 ;
      skos:prefLabel "Filter records to answer a question"@en ; al:prerequisite ex:cap-explore-dataset .
  ex:cap-combine-variables a al:Capability ; skos:inScheme ex:framework ; skos:notation "combine-variables" ; al:ordinal 5 ;
      skos:prefLabel "Calculate a vaccination proportion"@en ;
      al:prerequisite ex:cap-filter-records, ex:cap-data-vs-information .
  ex:cap-machine-readable a al:Capability ; skos:inScheme ex:framework ; skos:notation "machine-readable" ; al:ordinal 6 ;
      skos:prefLabel "Recognise machine-readable dataset structure"@en ; al:prerequisite ex:cap-explore-dataset .
  ex:cap-case-vs-aggregate a al:Capability ; skos:inScheme ex:framework ; skos:notation "case-vs-aggregate" ; al:ordinal 7 ;
      skos:prefLabel "Distinguish case-based and aggregate datasets"@en ; al:prerequisite ex:cap-machine-readable .

  ex:aud-fetp-trainee a al:Audience ; rdfs:label "FETP trainees"@en .

  ex:t-data-to-decision a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-data-to-decision ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-system-map a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-system-map ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-data-vs-information a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-data-vs-information ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-explore-dataset a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-explore-dataset ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-filter-records a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-filter-records ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-combine-variables a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-combine-variables ;
      al:targetLevel dreyfus:competent ; al:isCritical true .
  ex:t-machine-readable a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-machine-readable ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-case-vs-aggregate a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-case-vs-aggregate ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
}

g:activities {
  ex:act-u01-data-to-decision a al:LearningActivity ; dcterms:title "Unit 1: From data to a public health decision"@en ; al:ordinal 0 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-data-to-decision ;
      al:usesAsset ex:nb-u01-data-to-decision-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-u01-data-to-decision .
  ex:act-u02-system-map a al:LearningActivity ; dcterms:title "Unit 2: Trace Laila's reporting pathways"@en ; al:ordinal 1 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-system-map ;
      al:usesAsset ex:nb-u02-system-map-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-u02-system-map .
  ex:act-data-or-information a al:LearningActivity ; dcterms:title "Data or information?"@en ; al:ordinal 2 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-data-vs-information ;
      al:usesAsset ex:nb-data-or-information-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-data-or-information .
  ex:act-explore-dataset a al:LearningActivity ; dcterms:title "Explore the immunisation register"@en ; al:ordinal 3 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-explore-dataset ;
      al:usesAsset ex:nb-explore-dataset-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-explore-dataset .
  ex:act-filter-records a al:LearningActivity ; dcterms:title "Filter the records you need"@en ; al:ordinal 4 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-filter-records ;
      al:usesAsset ex:nb-filter-records-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-filter-records .
  ex:act-coverage a al:LearningActivity ; dcterms:title "Turn data into information: vaccination coverage"@en ; al:ordinal 5 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-combine-variables ;
      al:usesAsset ex:nb-coverage-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-coverage .
  ex:act-machine-readable a al:LearningActivity ; dcterms:title "Machine-readable or human-readable?"@en ; al:ordinal 6 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-machine-readable ;
      al:usesAsset ex:nb-machine-readable-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-machine-readable .

  ex:act-case-or-aggregate a al:LearningActivity ; dcterms:title "Case-based or aggregate?"@en ; al:ordinal 7 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-case-vs-aggregate ;
      al:usesAsset ex:nb-case-or-aggregate-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-case-or-aggregate .

  # Python-only pilot: query a synthetic case dataset through a browser-local
  # adapter. Reuses the dataset-exploration criterion; no server or PHI.
  ex:act-dhis2-query a al:LearningActivity ; dcterms:title "Explore synthetic case events through a DHIS2 adapter"@en ; al:ordinal 9 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-explore-dataset ;
      al:usesAsset ex:nb-dhis2-query-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-dhis2-query .

  # The former external Unit 3 form is retained in the repository form-link
  # audit, pending export review. Learners use the local notebook tasks.

  ex:nb-u01-data-to-decision-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u01-n01-data-to-decision.ipynb" .
  ex:nb-u02-system-map-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u02-n01-system-map.ipynb" .
  ex:nb-case-or-aggregate-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n06-case-or-aggregate.ipynb" .
  ex:nb-dhis2-query-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n07-dhis2-query.ipynb" .
  ex:nb-data-or-information-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n01-data-or-information.ipynb" .
  ex:nb-explore-dataset-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n02-explore-dataset.ipynb" .
  ex:nb-filter-records-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n03-filter-records.ipynb" .
  ex:nb-coverage-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n04-coverage.ipynb" .
  ex:nb-machine-readable-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "notebooks/u03-n05-machine-readable.ipynb" .

  ex:rubric a al:Rubric ; dcterms:title "Exercise result matches the expected value"@en ;
      al:criterion ex:crit-u01-data-to-decision, ex:crit-u02-system-map, ex:crit-data-or-information, ex:crit-explore-dataset, ex:crit-filter-records, ex:crit-coverage, ex:crit-machine-readable, ex:crit-case-or-aggregate .
  ex:crit-u01-data-to-decision a al:RubricCriterion ; al:criterionCapability ex:cap-data-to-decision .
  ex:crit-u02-system-map a al:RubricCriterion ; al:criterionCapability ex:cap-system-map .
  ex:crit-data-or-information a al:RubricCriterion ; al:criterionCapability ex:cap-data-vs-information .
  ex:crit-explore-dataset a al:RubricCriterion ; al:criterionCapability ex:cap-explore-dataset .
  ex:crit-filter-records a al:RubricCriterion ; al:criterionCapability ex:cap-filter-records .
  ex:crit-coverage a al:RubricCriterion ; al:criterionCapability ex:cap-combine-variables .
  ex:crit-machine-readable a al:RubricCriterion ; al:criterionCapability ex:cap-machine-readable .
  ex:crit-case-or-aggregate a al:RubricCriterion ; al:criterionCapability ex:cap-case-vs-aggregate .

  # A correct result validated in the learner's own Jupyter kernel is
  # simulation-stage evidence, provided no more than ladder level 2 was used.
  ex:rule-u01-data-to-decision a al:EvidenceRule ; al:supportsCriterion ex:crit-u01-data-to-decision ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-u02-system-map a al:EvidenceRule ; al:supportsCriterion ex:crit-u02-system-map ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-data-or-information a al:EvidenceRule ; al:supportsCriterion ex:crit-data-or-information ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-explore-dataset a al:EvidenceRule ; al:supportsCriterion ex:crit-explore-dataset ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-dhis2-query a al:EvidenceRule ; al:supportsCriterion ex:crit-explore-dataset ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-filter-records a al:EvidenceRule ; al:supportsCriterion ex:crit-filter-records ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-coverage a al:EvidenceRule ; al:supportsCriterion ex:crit-coverage ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-machine-readable a al:EvidenceRule ; al:supportsCriterion ex:crit-machine-readable ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-case-or-aggregate a al:EvidenceRule ; al:supportsCriterion ex:crit-case-or-aggregate ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
}

g:governance {
  ex:policy a al:EstimatorPolicy ; al:policyVersion "prototype-0.1" ;
      rdfs:comment "Prototype fixture: correct evidence supports the stage ceiling level. Not validated parameters."@en ;
      al:hasStageCeiling ex:ceil-self, ex:ceil-completion, ex:ceil-check, ex:ceil-sim, ex:ceil-practice .
  ex:ceil-self a al:StageCeiling ; al:ceilingStage al:SelfReport ; al:ceilingLevel dreyfus:advanced-beginner .
  ex:ceil-completion a al:StageCeiling ; al:ceilingStage al:Completion ; al:ceilingLevel dreyfus:novice .
  ex:ceil-check a al:StageCeiling ; al:ceilingStage al:KnowledgeCheck ; al:ceilingLevel dreyfus:advanced-beginner .
  ex:ceil-sim a al:StageCeiling ; al:ceilingStage al:Simulation ; al:ceilingLevel dreyfus:competent .
  ex:ceil-practice a al:StageCeiling ; al:ceilingStage al:ReviewedPractice ; al:ceilingLevel dreyfus:expert .
}

# Unit 4 Python computational narrative.
g:catalog {
  ex:framework al:hasCapability ex:cap-u04-source-inventory .
  ex:cap-u04-source-inventory a al:Capability ; skos:inScheme ex:framework ; skos:notation "u04-source-inventory" ; al:ordinal 10 ;
    skos:prefLabel "Compare data sources for an investigation"@en ; al:prerequisite ex:cap-case-vs-aggregate .
  ex:t-u04-source-inventory a al:CapabilityTarget ; al:forAudience ex:aud-fetp-trainee ; al:targetCapability ex:cap-u04-source-inventory ;
    al:targetLevel dreyfus:competent ; al:isCritical false .
}
g:activities {
  ex:act-u04-source-inventory a al:LearningActivity ; dcterms:title "Unit 4: Find the data Laila needs"@en ; al:ordinal 10 ;
    al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-u04-source-inventory ;
    al:usesAsset ex:nb-u04-source-inventory-python ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-u04-source-inventory .
  ex:nb-u04-source-inventory-python a al:LearningAsset ; schema:programmingLanguage "python" ;
    schema:contentUrl "notebooks/u04-n01-source-inventory.ipynb" .
  ex:rubric al:criterion ex:crit-u04-source-inventory .
  ex:crit-u04-source-inventory a al:RubricCriterion ; al:criterionCapability ex:cap-u04-source-inventory .
  ex:rule-u04-source-inventory a al:EvidenceRule ; al:supportsCriterion ex:crit-u04-source-inventory ; al:evidenceStage al:Simulation ;
    al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
}

