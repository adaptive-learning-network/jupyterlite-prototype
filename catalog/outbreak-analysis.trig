@prefix al:      <https://adaptive-learning-network.github.io/adaptive-learning-ontology/al#> .
@prefix dreyfus: <https://adaptive-learning-network.github.io/adaptive-learning-ontology/scales/dreyfus#> .
@prefix ex:      <https://adaptive-learning-network.github.io/jupyterlite-prototype/catalog#> .
@prefix g:       <https://adaptive-learning-network.github.io/jupyterlite-prototype/graph/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# Prototype curriculum: introductory outbreak analysis on a synthetic picnic
# outbreak. Every activity has a Python and an R notebook; both are bound to
# the same al: capability, so the adaptive-learning engine is language-neutral.
# This file is the source of truth; scripts/build_catalog.py validates it with
# the al: shapes and projects it to content/al/catalog.json for the browser.

g:catalog {
  ex:framework a al:CapabilityFramework ;
      dcterms:title "Introductory outbreak analysis"@en ;
      al:usesScale dreyfus:scale ;
      al:hasCapability ex:cap-frequency, ex:cap-attack-rate, ex:cap-risk-ratio, ex:cap-interpret-rr .

  ex:cap-frequency a al:Capability ; skos:inScheme ex:framework ; skos:notation "frequency" ; al:ordinal 1 ;
      skos:prefLabel "Count cases by exposure"@en .
  ex:cap-attack-rate a al:Capability ; skos:inScheme ex:framework ; skos:notation "attack-rate" ; al:ordinal 2 ;
      skos:prefLabel "Calculate attack rates"@en ; al:prerequisite ex:cap-frequency .
  ex:cap-risk-ratio a al:Capability ; skos:inScheme ex:framework ; skos:notation "risk-ratio" ; al:ordinal 3 ;
      skos:prefLabel "Calculate a risk ratio"@en ; al:prerequisite ex:cap-attack-rate .
  ex:cap-interpret-rr a al:Capability ; skos:inScheme ex:framework ; skos:notation "interpret-risk-ratio" ; al:ordinal 4 ;
      skos:prefLabel "Interpret a risk ratio"@en ; al:prerequisite ex:cap-risk-ratio .

  ex:aud-intro a al:Audience ; rdfs:label "Introductory analysis learners"@en .

  ex:t-frequency a al:CapabilityTarget ; al:forAudience ex:aud-intro ; al:targetCapability ex:cap-frequency ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-attack-rate a al:CapabilityTarget ; al:forAudience ex:aud-intro ; al:targetCapability ex:cap-attack-rate ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
  ex:t-risk-ratio a al:CapabilityTarget ; al:forAudience ex:aud-intro ; al:targetCapability ex:cap-risk-ratio ;
      al:targetLevel dreyfus:competent ; al:isCritical true .
  ex:t-interpret-rr a al:CapabilityTarget ; al:forAudience ex:aud-intro ; al:targetCapability ex:cap-interpret-rr ;
      al:targetLevel dreyfus:competent ; al:isCritical false .
}

g:activities {
  ex:act-frequency a al:LearningActivity ; dcterms:title "Count cases by exposure"@en ; al:ordinal 1 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-frequency ;
      al:usesAsset ex:nb-frequency-python, ex:nb-frequency-r ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-frequency .
  ex:act-attack-rate a al:LearningActivity ; dcterms:title "Calculate attack rates"@en ; al:ordinal 2 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-attack-rate ;
      al:usesAsset ex:nb-attack-rate-python, ex:nb-attack-rate-r ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-attack-rate .
  ex:act-risk-ratio a al:LearningActivity ; dcterms:title "Calculate a risk ratio"@en ; al:ordinal 3 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-risk-ratio ;
      al:usesAsset ex:nb-risk-ratio-python, ex:nb-risk-ratio-r ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-risk-ratio .
  ex:act-interpret-rr a al:LearningActivity ; dcterms:title "Interpret a risk ratio"@en ; al:ordinal 4 ;
      al:activityKind al:SimulationActivity ; al:assessesCapability ex:cap-interpret-rr ;
      al:usesAsset ex:nb-interpret-rr-python, ex:nb-interpret-rr-r ; al:usesRubric ex:rubric ; al:hasEvidenceRule ex:rule-interpret-rr .

  ex:nb-frequency-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "exercises/python/01-frequency.ipynb" .
  ex:nb-frequency-r a al:LearningAsset ; schema:programmingLanguage "r" ; schema:contentUrl "exercises/r/01-frequency.ipynb" .
  ex:nb-attack-rate-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "exercises/python/02-attack-rate.ipynb" .
  ex:nb-attack-rate-r a al:LearningAsset ; schema:programmingLanguage "r" ; schema:contentUrl "exercises/r/02-attack-rate.ipynb" .
  ex:nb-risk-ratio-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "exercises/python/03-risk-ratio.ipynb" .
  ex:nb-risk-ratio-r a al:LearningAsset ; schema:programmingLanguage "r" ; schema:contentUrl "exercises/r/03-risk-ratio.ipynb" .
  ex:nb-interpret-rr-python a al:LearningAsset ; schema:programmingLanguage "python" ; schema:contentUrl "exercises/python/04-interpret-risk-ratio.ipynb" .
  ex:nb-interpret-rr-r a al:LearningAsset ; schema:programmingLanguage "r" ; schema:contentUrl "exercises/r/04-interpret-risk-ratio.ipynb" .

  ex:rubric a al:Rubric ; dcterms:title "Exercise result matches the expected value"@en ;
      al:criterion ex:crit-frequency, ex:crit-attack-rate, ex:crit-risk-ratio, ex:crit-interpret-rr .
  ex:crit-frequency a al:RubricCriterion ; al:criterionCapability ex:cap-frequency .
  ex:crit-attack-rate a al:RubricCriterion ; al:criterionCapability ex:cap-attack-rate .
  ex:crit-risk-ratio a al:RubricCriterion ; al:criterionCapability ex:cap-risk-ratio .
  ex:crit-interpret-rr a al:RubricCriterion ; al:criterionCapability ex:cap-interpret-rr .

  # A correct result validated in the learner's own Jupyter kernel is
  # simulation-stage evidence, provided no more than ladder level 2 was used.
  ex:rule-frequency a al:EvidenceRule ; al:supportsCriterion ex:crit-frequency ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-attack-rate a al:EvidenceRule ; al:supportsCriterion ex:crit-attack-rate ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-risk-ratio a al:EvidenceRule ; al:supportsCriterion ex:crit-risk-ratio ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
  ex:rule-interpret-rr a al:EvidenceRule ; al:supportsCriterion ex:crit-interpret-rr ; al:evidenceStage al:Simulation ;
      al:requiredAction al:OutputValidated ; al:acceptedOutcome al:Correct ; al:maximumGuidance 2 .
}

g:governance {
  ex:policy a al:EstimatorPolicy ; al:policyVersion "prototype-0.1" ;
      rdfs:comment "Prototype fixture: correct evidence supports the stage ceiling level. Not validated parameters."@en ;
      al:hasStageCeiling ex:ceil-self, ex:ceil-completion, ex:ceil-check, ex:ceil-sim, ex:ceil-practice .
  ex:ceil-self a al:StageCeiling ; al:ceilingStage al:SelfReport ; al:ceilingLevel dreyfus:advanced-beginner .
  ex:ceil-completion a al:StageCeiling ; al:ceilingStage al:Completion ; al:ceilingLevel dreyfus:novice .
  ex:ceil-check a al:StageCeiling ; al:ceilingStage al:KnowledgeCheck ; al:ceilingLevel dreyfus:advanced-beginner .
  ex:ceil-sim a al:StageCeiling ; al:ceilingStage al:Simulation ; al:ceilingLevel dreyfus:competent .
  ex:ceil-practice a al:StageCeiling ; al:ceilingStage al:ReviewedPractice ; al:ceilingLevel dreyfus:expert .
}
