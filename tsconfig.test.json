{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "strict": true,
    "outDir": "lib-test",
    "rootDir": ".",
    "target": "ES2020",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/engine/**/*", "test/**/*"]
}
